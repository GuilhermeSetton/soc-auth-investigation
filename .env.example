# Copy only for manual setup; setup-db.ps1 generates local random credentials.
POSTGRES_PASSWORD=replace-with-local-random-value
DATABASE_URL=postgresql://soc_auth:replace-with-local-random-value@127.0.0.1:5432/soc_auth
TEST_DATABASE_URL=postgresql://soc_auth:replace-with-local-random-value@127.0.0.1:5432/soc_auth_test
